{
  "dash/meta": {
    "title": "Mi Fitbit",
    "lang": "es"
  },
  "dash/params": {
    "desde": "2026-10-12",
    "hasta": "2026-11-10"
  },
  "datasets/serie": {
    "title": "Serie diaria de tu Fitbit",
    "description": "Una fila por día con el sueño, la actividad y las señales de salud que registra tu Fitbit Air.",
    "source": {
      "kind": "call",
      "connector": "Fit Bit",
      "tool": "serie_diaria",
      "args": {
        "desde": "{{desde}}",
        "hasta": "{{hasta}}"
      },
      "rules": {
        "desde": {
          "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
        },
        "hasta": {
          "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
        }
      }
    }
  },
  "datasets/sesiones": {
    "title": "Sesiones de ejercicio",
    "description": "Cada sesión de ejercicio que registró tu Fitbit en el periodo.",
    "source": {
      "kind": "call",
      "connector": "Fit Bit",
      "tool": "sesiones_ejercicio",
      "args": {
        "desde": "{{desde}}",
        "hasta": "{{hasta}}"
      },
      "rules": {
        "desde": {
          "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
        },
        "hasta": {
          "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
        }
      }
    }
  }
}